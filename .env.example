# Tek .env — tüm app (frontend + runtime) buradan okur.
# Kopyalayın: cp .env.example .env
# start.sh / start.mjs .env yoksa bunu otomatik kopyalar.

# ── Frontend (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_RUNTIME_URL=http://127.0.0.1:8000

# ── Runtime (FastAPI, pydantic-settings IO_CAM_ prefix) ─────────
IO_CAM_MOCK_HARDWARE=0
IO_CAM_SERIAL_PORT=/dev/ttyUSB0
IO_CAM_SERIAL_BAUD=115200
# IO_CAM_VACUUM_SENSOR_PIN=13
IO_CAM_CAMERA_INDEX=0
IO_CAM_CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002

# Mock (kamera/seri port yokken):
# IO_CAM_MOCK_HARDWARE=1

# VLM — tek seferde çok taş; face-up (true) olanı pick et
IO_CAM_VLM_PROMPT=stone
IO_CAM_VLM_MAX_STONES=10
# 0.6B (detection+seg): tiiuae/Falcon-Perception
# 0.3B (detection-only): tiiuae/Falcon-Perception-300M
IO_CAM_VLM_MODEL=tiiuae/Falcon-Perception

# Orientation CNN (ONNX) — boş bırakılırsa datasets/orientation_model_v2 kullanılır
# IO_CAM_ORIENTATION_MODEL_DIR=/absolute/path/to/orientation_model_v2
